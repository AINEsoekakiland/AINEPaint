<Window x:Class="AINEPaint.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:drawing="clr-namespace:AINEPaint.Drawing"
        Title="AINE Paint"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True"
        TextElement.Foreground="{StaticResource ForegroundBrush}"
        Closing="OnWindowClosing">

    <Window.Resources>
        <Image x:Key="Icon_pen"        Source="/Assets/Icons/pen.png"        Width="28" Height="28" />
        <Image x:Key="Icon_pencil"     Source="/Assets/Icons/pencil.png"     Width="28" Height="28" />
        <Image x:Key="Icon_eraser"     Source="/Assets/Icons/eraser.png"     Width="28" Height="28" />
        <Image x:Key="Icon_fill"       Source="/Assets/Icons/fill.png"       Width="28" Height="28" />
        <Image x:Key="Icon_move"       Source="/Assets/Icons/move.png"       Width="28" Height="28" />
        <Image x:Key="Icon_eyedropper" Source="/Assets/Icons/eyedropper.png" Width="28" Height="28" />
        <Image x:Key="Icon_selectrect"  Source="/Assets/Icons/select-rect.png"  Width="28" Height="28" />
        <Image x:Key="Icon_selectlasso" Source="/Assets/Icons/select-lasso.png" Width="28" Height="28" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== メニュー ===== -->
        <Menu Grid.Row="0" Padding="4,2">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="新規キャンバス..."   InputGestureText="Ctrl+N"       Click="OnNewCanvasClick" />
                <MenuItem Header="開く..."             InputGestureText="Ctrl+O"       Click="OnOpenClick" />
                <Separator />
                <MenuItem Header="保存"                InputGestureText="Ctrl+S"       Click="OnSaveClick" />
                <MenuItem Header="名前を付けて保存..." InputGestureText="Ctrl+Shift+S" Click="OnSaveAsClick" />
                <MenuItem Header="PNGで書き出し..."    InputGestureText="Ctrl+E"       Click="OnExportPngClick" />
                <Separator />
                <MenuItem Header="終了" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="編集(_E)">
                <MenuItem x:Name="UndoMenuItem" Header="元に戻す" InputGestureText="Ctrl+Z"
                          IsEnabled="False" Click="OnUndoClick" />
                <MenuItem x:Name="RedoMenuItem" Header="やり直し" InputGestureText="Ctrl+Shift+Z"
                          IsEnabled="False" Click="OnRedoClick" />
                <Separator />
                <MenuItem Header="すべて選択" InputGestureText="Ctrl+A" Click="OnSelectAllClick" />
                <MenuItem Header="選択を解除" InputGestureText="Ctrl+D" Click="OnDeselectClick" />
            </MenuItem>
            <MenuItem Header="表示(_V)">
                <MenuItem Header="ズームイン"   InputGestureText="Ctrl++" Click="OnZoomInClick" />
                <MenuItem Header="ズームアウト" InputGestureText="Ctrl+-" Click="OnZoomOutClick" />
                <MenuItem Header="全体表示"     InputGestureText="Ctrl+0" Click="OnFitClick" />
            </MenuItem>
        </Menu>

        <!-- ===== 本体 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ToolPanel" Margin="0,8">
                    <RadioButton GroupName="Tools" Focusable="False" Style="{StaticResource ToolButtonStyle}"
                                 Tag="Pen" IsChecked="True" Checked="OnToolChecked"
                                 Content="{StaticResource Icon_pen}"
                                 ToolTip="ペン (P)" />
                    <RadioButton GroupName="Tools" Focusable="False" Style="{StaticResource ToolButtonStyle}"
                                 Tag="Pencil" Checked="OnToolChecked"
                                 Content="{StaticResource Icon_pencil}"
                                 ToolTip="鉛筆 (N)" />
                    <RadioButton GroupName="Tools" Focusable="False" Style="{StaticResource ToolButtonStyle}"
                                 Tag="Eraser" Checked="OnToolChecked"
                                 Content="{StaticResource Icon_eraser}"
                                 ToolTip="消しゴム (E)" />
                    <RadioButton GroupName="Tools" Focusable="False" Style="{StaticResource ToolButtonStyle}"
                                 Tag="Fill" Checked="OnToolChecked"
                                 Content="{StaticResource Icon_fill}"
                                 ToolTip="塗りつぶし (G)" />
                    <RadioButton GroupName="Tools" Focusable="False" Style="{StaticResource ToolButtonStyle}"
                                 Tag="SelectRect" Checked="OnToolChecked"
                                 Content="{StaticResource Icon_selectrect}"
                                 ToolTip="長方形で選択 (M)" />
                    <RadioButton GroupName="Tools" Focusable="False" Style="{StaticResource ToolButtonStyle}"
                                 Tag="SelectLasso" Checked="OnToolChecked"
                                 Content="{StaticResource Icon_selectlasso}"
                                 ToolTip="なげなわで選択 (L)" />
                    <RadioButton GroupName="Tools" Focusable="False" Style="{StaticResource ToolButtonStyle}"
                                 Tag="Transform" Checked="OnToolChecked"
                                 Content="{StaticResource Icon_move}"
                                 ToolTip="選択範囲を移動・拡大縮小・回転 (T)" />
                    <RadioButton GroupName="Tools" Focusable="False" Style="{StaticResource ToolButtonStyle}"
                                 Content="🖐" Tag="Pan" Checked="OnToolChecked"
                                 ToolTip="移動 (H) ／ スペース+ドラッグ・中ボタンドラッグでも可" />
                    <RadioButton GroupName="Tools" Focusable="False" Style="{StaticResource ToolButtonStyle}"
                                 Tag="Picker" Checked="OnToolChecked"
                                 Content="{StaticResource Icon_eyedropper}"
                                 ToolTip="スポイト (I)" />
                </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1">
                <drawing:CanvasView x:Name="Canvas" />
                <TextBlock x:Name="EmptyHint"
                           Text="ファイル → 新規キャンバス（Ctrl+N）でキャンバスを作成してください"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Opacity="0.45" FontSize="13" IsHitTestVisible="False" />
            </Grid>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1,0,0,0">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="レイヤー" FontSize="14" FontWeight="Bold" Margin="2,4,2,8" />

                    <UniformGrid DockPanel.Dock="Bottom" Rows="1" Columns="5" Margin="0,8,0,0">
                        <Button Content="＋" Height="30" Margin="1,0" Foreground="#1E1E1E"
                                Click="OnAddLayerClick" ToolTip="レイヤーを追加" />
                        <Button Content="⧉" Height="30" Margin="1,0" Foreground="#1E1E1E"
                                Click="OnDuplicateLayerClick" ToolTip="レイヤーを複製" />
                        <Button Content="🗑" Height="30" Margin="1,0" Foreground="#1E1E1E"
                                Click="OnDeleteLayerClick" ToolTip="レイヤーを削除" />
                        <Button Content="↑" Height="30" Margin="1,0" Foreground="#1E1E1E"
                                Click="OnMoveLayerUpClick" ToolTip="1つ上へ" />
                        <Button Content="↓" Height="30" Margin="1,0" Foreground="#1E1E1E"
                                Click="OnMoveLayerDownClick" ToolTip="1つ下へ" />
                    </UniformGrid>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <DockPanel>
                            <TextBlock x:Name="LayerOpacityText" DockPanel.Dock="Right"
                                       Text="100%" FontSize="12" Opacity="0.7" />
                            <TextBlock Text="レイヤー不透明度" FontSize="12" Opacity="0.7" />
                        </DockPanel>
                        <Slider x:Name="LayerOpacitySlider" Minimum="0" Maximum="100" Value="100"
                                IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,4,0,0"
                                ValueChanged="OnLayerOpacityChanged" />
                    </StackPanel>

                    <ListBox x:Name="LayerList"
                             Background="{StaticResource PanelBrush}"
                             BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                             HorizontalContentAlignment="Stretch"
                             SelectionChanged="OnLayerSelectionChanged"
                             MouseDoubleClick="OnLayerListDoubleClick"
                             ToolTip="ダブルクリックで名前を変更できます">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Height="28">
                                    <CheckBox DockPanel.Dock="Left"
                                              IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="2,0,8,0"
                                              ToolTip="表示 / 非表示" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== 下部バー ===== -->
        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <DockPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right"
                           Text="キャンバスなし" Opacity="0.55" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <StackPanel x:Name="BrushOptions" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="サイズ" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider x:Name="SizeSlider" Width="140" Minimum="1" Maximum="200" Value="12"
                            SmallChange="1" LargeChange="8" IsSnapToTickEnabled="True" TickFrequency="1"
                            VerticalAlignment="Center" ValueChanged="OnSizeChanged"
                            ToolTip="ブラシの太さ（[ と ] でも変更できます）" />
                    <TextBlock x:Name="SizeValueText" Text="12" Width="34" TextAlignment="Right"
                               VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7" />

                    <TextBlock Text="不透明度" VerticalAlignment="Center" Margin="24,0,8,0" />
                    <Slider x:Name="OpacitySlider" Width="140" Minimum="0" Maximum="100" Value="100"
                            SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1"
                            VerticalAlignment="Center" ValueChanged="OnOpacityChanged" />
                    <TextBlock x:Name="OpacityValueText" Text="100%" Width="42" TextAlignment="Right"
                               VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7" />
                  </StackPanel>

                  <StackPanel x:Name="FillOptions" Orientation="Horizontal" VerticalAlignment="Center"
                              Visibility="Collapsed">
                    <TextBlock Text="許容値" VerticalAlignment="Center" Margin="0,0,8,0"
                               ToolTip="大きくすると、色の近い部分までまとめて塗ります" />
                    <Slider x:Name="ToleranceSlider" Width="140" Minimum="0" Maximum="128" Value="24"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            VerticalAlignment="Center" ValueChanged="OnToleranceChanged" />
                    <TextBlock x:Name="ToleranceValueText" Text="24" Width="34" TextAlignment="Right"
                               VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7" />

                    <TextBlock Text="はみ出し" VerticalAlignment="Center" Margin="24,0,8,0"
                               ToolTip="線の縁に白い隙間が残るときは大きくします" />
                    <Slider x:Name="FillExpandSlider" Width="100" Minimum="0" Maximum="6" Value="1"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            VerticalAlignment="Center" ValueChanged="OnFillExpandChanged" />
                    <TextBlock x:Name="FillExpandValueText" Text="1" Width="24" TextAlignment="Right"
                               VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7" />
                  </StackPanel>

                    <TextBlock Text="色" VerticalAlignment="Center" Margin="24,0,8,0" />
                    <Button x:Name="ColorButton" Width="30" Height="30" Padding="0"
                            Background="Black" BorderBrush="{StaticResource BorderBrush2}"
                            BorderThickness="1" Cursor="Hand" Click="OnColorButtonClick"
                            ToolTip="描画色を選ぶ（スポイトは I）" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="AINEPaint.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:drawing="clr-namespace:AINEPaint.Drawing"
        Title="AINE Paint"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== メニュー ===== -->
        <Menu Grid.Row="0" Padding="4,2">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="新規キャンバス..." InputGestureText="Ctrl+N" Click="OnNewCanvasClick" />
                <MenuItem Header="開く..."           IsEnabled="False" />
                <Separator />
                <MenuItem Header="保存"              IsEnabled="False" />
                <MenuItem Header="PNGで書き出し..."  IsEnabled="False" />
                <Separator />
                <MenuItem Header="終了" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="編集(_E)">
                <MenuItem Header="元に戻す" InputGestureText="Ctrl+Z"       IsEnabled="False" />
                <MenuItem Header="やり直し" InputGestureText="Ctrl+Shift+Z" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="表示(_V)">
                <MenuItem Header="ズームイン"   InputGestureText="Ctrl++" Click="OnZoomInClick" />
                <MenuItem Header="ズームアウト" InputGestureText="Ctrl+-" Click="OnZoomOutClick" />
                <MenuItem Header="全体表示"     InputGestureText="Ctrl+0" Click="OnFitClick" />
            </MenuItem>
        </Menu>

        <!-- ===== 本体 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="0,0,1,0">
                <StackPanel Margin="0,8">
                    <RadioButton GroupName="Tools" Focusable="False" Style="{StaticResource ToolButtonStyle}" Content="🖊" IsChecked="True" ToolTip="ペン" />
                    <RadioButton GroupName="Tools" Focusable="False" Style="{StaticResource ToolButtonStyle}" Content="✏"  ToolTip="鉛筆" />
                    <RadioButton GroupName="Tools" Focusable="False" Style="{StaticResource ToolButtonStyle}" Content="🧽" ToolTip="消しゴム" />
                    <RadioButton GroupName="Tools" Focusable="False" Style="{StaticResource ToolButtonStyle}" Content="🖐" ToolTip="移動（スペース+ドラッグ / 中ボタンドラッグ）" />
                    <RadioButton GroupName="Tools" Focusable="False" Style="{StaticResource ToolButtonStyle}" Content="💧" ToolTip="スポイト" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <drawing:CanvasView x:Name="Canvas" />
                <TextBlock x:Name="EmptyHint"
                           Text="ファイル → 新規キャンバス（Ctrl+N）でキャンバスを作成してください"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Opacity="0.45" FontSize="13" IsHitTestVisible="False" />
            </Grid>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1,0,0,0">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="レイヤー" FontSize="14" FontWeight="Bold" Margin="2,4,2,8" />
                    <TextBlock Text="（未実装）" Opacity="0.4" FontSize="12" Margin="2,0" VerticalAlignment="Top" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== 下部バー ===== -->
        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <DockPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right"
                           Text="キャンバスなし" Opacity="0.55" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="サイズ" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider Width="120" Minimum="1" Maximum="200" Value="12" IsEnabled="False" VerticalAlignment="Center" />

                    <TextBlock Text="不透明度" VerticalAlignment="Center" Margin="24,0,8,0" />
                    <Slider Width="120" Minimum="0" Maximum="100" Value="100" IsEnabled="False" VerticalAlignment="Center" />

                    <TextBlock Text="色" VerticalAlignment="Center" Margin="24,0,8,0" />
                    <Border Width="28" Height="28" CornerRadius="4"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                            ToolTip="現在の描画色" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

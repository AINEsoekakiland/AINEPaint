<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AINEPaint</AssemblyName>
    <RootNamespace>AINEPaint</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Company>StudioAINE</Company>
    <Product>AINE Paint</Product>
    <Authors>StudioAINE</Authors>
    <Copyright>© StudioAINE</Copyright>
    <Description>子どもから大人まで使える、無料のWindows向けお絵描きソフト</Description>
    <Platforms>x64</Platforms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- 配布用の設定（自己完結・単一exe）は build/publish.ps1 側で指定する。
         csproj に書くと日常の dotnet run まで重くなるため。 -->
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- 描画エンジン。MVPの中心になる依存なので、STEP 5 の時点で解決できるか確認する。 -->
    <PackageReference Include="SkiaSharp.Views.WPF" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- ツールアイコン。exe に埋め込むので配布時に別ファイルにならない。 -->
    <Resource Include="Assets\Icons\*.png" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

</Project>

<Window x:Class="AINEPaint.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:color="clr-namespace:AINEPaint.Color"
        Title="色の選択"
        Width="360" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        TextElement.Foreground="{StaticResource ForegroundBrush}">

    <StackPanel Margin="16">

        <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
            <color:SaturationValueBox x:Name="SvBox" Height="200" />
        </Border>

        <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Margin="0,12,0,0">
            <color:HueBar x:Name="HueBar" Height="24" />
        </Border>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="HEX" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" x:Name="HexBox" Height="30" Padding="6,4"
                     Foreground="#1E1E1E" VerticalContentAlignment="Center"
                     FontFamily="Consolas" TextChanged="OnHexChanged" />

            <Border Grid.Column="2" x:Name="PreviewSwatch"
                    Width="44" Height="30" Margin="12,0,0,0" CornerRadius="4"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" />
        </Grid>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="R" Margin="0,0,0,4" />
                <TextBox x:Name="RBox" Height="28" Padding="6,2" Foreground="#1E1E1E"
                         VerticalContentAlignment="Center" TextChanged="OnRgbChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="G" Margin="0,0,0,4" />
                <TextBox x:Name="GBox" Height="28" Padding="6,2" Foreground="#1E1E1E"
                         VerticalContentAlignment="Center" TextChanged="OnRgbChanged" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="B" Margin="0,0,0,4" />
                <TextBox x:Name="BBox" Height="28" Padding="6,2" Foreground="#1E1E1E"
                         VerticalContentAlignment="Center" TextChanged="OnRgbChanged" />
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="決定" Width="96" Height="32" Foreground="#1E1E1E"
                    IsDefault="True" Click="OnOkClick" Margin="0,0,8,0" />
            <Button Content="キャンセル" Width="96" Height="32" Foreground="#1E1E1E"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>

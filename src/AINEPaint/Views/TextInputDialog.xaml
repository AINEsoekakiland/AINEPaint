<Window x:Class="AINEPaint.Views.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="名前の変更"
        Width="340" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        TextElement.Foreground="{StaticResource ForegroundBrush}">

    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Text="名前" Margin="0,0,0,6" />
        <TextBox x:Name="InputBox" Height="30" Padding="6,4" Foreground="#1E1E1E"
                 VerticalContentAlignment="Center" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="88" Height="30" Foreground="#1E1E1E"
                    IsDefault="True" Click="OnOkClick" Margin="0,0,8,0" />
            <Button Content="キャンセル" Width="88" Height="30" Foreground="#1E1E1E"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>

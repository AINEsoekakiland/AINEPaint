<Window x:Class="AINEPaint.Views.RemoveBackgroundDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="背景を消す"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        TextElement.Foreground="{StaticResource ForegroundBrush}">

    <StackPanel Margin="18">

        <TextBlock TextWrapping="Wrap" LineHeight="21" Opacity="0.85"
                   Text="いま選んでいるレイヤーの、四すみから繋がっている背景を透明にします。絵の内側にある同じ色は消えません。" />

        <TextBlock TextWrapping="Wrap" LineHeight="21" Opacity="0.6" FontSize="12" Margin="0,8,0,0"
                   Text="白い紙や単色の背景に向いています。景色が写り込んだ写真はうまくいきません。" />

        <DockPanel Margin="0,18,0,0">
            <TextBlock x:Name="ToleranceText" DockPanel.Dock="Right" Text="32"
                       Width="34" TextAlignment="Right" Opacity="0.7" />
            <TextBlock Text="消す範囲" Width="72" VerticalAlignment="Center" />
            <Slider x:Name="ToleranceSlider" Minimum="4" Maximum="128" Value="32"
                    IsMoveToPointEnabled="True" IsSnapToTickEnabled="True" TickFrequency="1"
                    VerticalAlignment="Center" ValueChanged="OnToleranceChanged"
                    ToolTip="大きくすると、背景に近い色まで広く消します" />
        </DockPanel>

        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6" Margin="0,8,0,0"
                   Text="消えすぎたり、残ったりしたときは、Ctrl+Z で戻してから数値を変えてやり直してください。" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="消す" Width="96" Height="32" Foreground="#1E1E1E"
                    IsDefault="True" Click="OnOkClick" Margin="0,0,8,0" />
            <Button Content="キャンセル" Width="96" Height="32" Foreground="#1E1E1E"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>

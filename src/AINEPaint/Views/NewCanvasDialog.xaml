<Window x:Class="AINEPaint.Views.NewCanvasDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新規キャンバス"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <StackPanel Margin="20">

        <TextBlock Text="プリセット" Margin="0,0,0,6" />
        <ComboBox x:Name="PresetBox" Height="30" SelectionChanged="OnPresetChanged">
            <ComboBoxItem Content="1920 × 1080 （フルHD）" Tag="1920x1080" />
            <ComboBoxItem Content="2048 × 2048 （正方形）" Tag="2048x2048" />
            <ComboBoxItem Content="3000 × 3000 （大きめ）" Tag="3000x3000" />
            <ComboBoxItem Content="カスタム" Tag="custom" />
        </ComboBox>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="幅 (px)" Margin="0,0,0,6" />
                <TextBox x:Name="WidthBox" Height="30" Padding="6,4"
                         VerticalContentAlignment="Center"
                         TextChanged="OnSizeTextChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="高さ (px)" Margin="0,0,0,6" />
                <TextBox x:Name="HeightBox" Height="30" Padding="6,4"
                         VerticalContentAlignment="Center"
                         TextChanged="OnSizeTextChanged" />
            </StackPanel>
        </Grid>

        <TextBlock Text="背景" Margin="0,16,0,6" />
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="WhiteBgRadio" Content="白" IsChecked="True"
                         Foreground="{StaticResource ForegroundBrush}"
                         VerticalContentAlignment="Center" Margin="0,0,24,0" />
            <RadioButton x:Name="TransparentBgRadio" Content="透明"
                         Foreground="{StaticResource ForegroundBrush}"
                         VerticalContentAlignment="Center" />
        </StackPanel>

        <TextBlock x:Name="InfoText" Margin="0,16,0,0" Opacity="0.6" FontSize="12"
                   TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="OkButton" Content="作成" Width="96" Height="32"
                    IsDefault="True" Click="OnOkClick" Margin="0,0,8,0" />
            <Button Content="キャンセル" Width="96" Height="32"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>

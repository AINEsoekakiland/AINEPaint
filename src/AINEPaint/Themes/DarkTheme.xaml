<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         AINE Paint ダークテーマ
         色は全てここに集約する。将来テーマを追加する場合は
         同じキー名で別 ResourceDictionary を作り、App.xaml で差し替える。
         ============================================================ -->

    <Color x:Key="BackgroundColor">#1E1E1E</Color>
    <Color x:Key="PanelColor">#252526</Color>
    <Color x:Key="BorderColor">#3C3C3C</Color>
    <Color x:Key="ForegroundColor">#E8E8E8</Color>
    <Color x:Key="AccentColor">#4EA1FF</Color>
    <Color x:Key="HoverColor">#333336</Color>
    <Color x:Key="SelectedColor">#1F3B5C</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="PanelBrush"      Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="BorderBrush2"    Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}" />
    <SolidColorBrush x:Key="AccentBrush"     Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="HoverBrush"      Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="SelectedBrush"   Color="{StaticResource SelectedColor}" />

    <!-- ツールボタン: 娘が押しやすいよう大きめ + ツールチップ前提 -->
    <Style x:Key="ToolButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="50" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Margin" Value="5,3" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        CheckBox / RadioButton の文字色。
        これらは Control.Foreground を自前で持っていて、Window の
        TextElement.Foreground を継承しないため、暗い既定色のまま残ってしまう。
    -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    </Style>

    <!-- ペン先の選択（右パネル）。文字だけの横長ボタン -->
    <Style x:Key="TipButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                            Padding="0" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Accent" Grid.Column="0" Margin="0,4"
                                    Background="Transparent" CornerRadius="2" />
                            <ContentPresenter Grid.Column="1" Margin="8,5"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}" />
                            <Setter TargetName="Accent" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Menu">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    </Style>

    <!--
        メニュー項目の文字色。
        ポップアップは Windows 標準の明るい背景のままなので、
        そこだけ暗い文字にしないと読めなくなる。
        メニューバー上の見出し（TopLevelHeader）は暗い背景なので明るい文字。
        ポップアップ自体のダーク化はテーマ整備のときにまとめて行う。
    -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="#1E1E1E" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        レイヤー一覧の行。
        WPF 既定の ListBoxItem は、ListBox がフォーカスを失うと選択色が薄くなり、
        キャンバスをクリックした瞬間にどれを選んでいるか分からなくなる。
        そのため IsSelected だけで見た目を決めるテンプレートを自前で持つ。
    -->
    <Style x:Key="LayerItemStyle" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Margin="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Accent" Grid.Column="0" Margin="0,3"
                                    Background="Transparent" CornerRadius="2" />
                            <ContentPresenter Grid.Column="1" Margin="6,0,4,0"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}" />
                            <Setter TargetName="Accent" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
